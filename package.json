{
  "name": "aquacraft",
  "version": "1.0.0",
  "private": true,
  "description": "AquaCraft - E-commerce platform for aquarium fish and accessories",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "test": "npm --prefix backend test",
    "lint": "node --check backend/src/server.js backend/src/app.js",
    "start:backend": "npm --prefix backend start",
    "seed:backend": "npm --prefix backend run seed",
    "setup:env": "node -e \"fs.copyFileSync('backend/.env.example', 'backend/.env'); console.log('Đã tạo backend/.env thành công!');\"",
    "client": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
